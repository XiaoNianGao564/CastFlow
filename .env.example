# Qwen / DashScope
DASHSCOPE_API_KEY=sk-your-key-here
LLM_MODEL=qwen-max
LLM_MODEL_SUBAGENT=qwen-plus

# Stage B5 - Langfuse 全链路 trace（可选，留空则关闭 trace）
# 自部署用本机 host：http://localhost:3000
# 云版用：https://cloud.langfuse.com 或 https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Stage B - MySQL (sxfhyc11)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=sxfhyc11
USE_REAL_DB=false
