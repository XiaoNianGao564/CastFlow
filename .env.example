# ============================================================
# CastFlow 环境变量配置模板
# ============================================================
# 使用方式：cp .env.example .env，然后编辑 .env 填入真实值
# .env 文件已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ═══════════════════════════════════════════════════
# 🔴 必填 — API Key (必须修改)
# ═══════════════════════════════════════════════════
# DashScope API Key 获取：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-key-here
LLM_MODEL=qwen3.6-flash
LLM_MODEL_SUBAGENT=qwen3.6-flash

# Langfuse 全链路 trace（可选，留空则关闭 trace）
# 自部署用本机 host：http://localhost:3000
# 云版用：https://cloud.langfuse.com 或 https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ═══════════════════════════════════════════════════
# 🟡 按需填写 — 数据库配置
# ═══════════════════════════════════════════════════
# MySQL 连接（容器部署时使用 docker-compose 中的值即可，本地开发需改为你的 MySQL 地址）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=castflow_db
USE_REAL_DB=false   # 设为 true 连接真实数据库

# ═══════════════════════════════════════════════════
# 🟢 可选 — 其他配置
# ═══════════════════════════════════════════════════
# Chroma HTTP server (留空则用本地 PersistentClient；推荐 Docker 部署后填 chromadb:8000)
CHROMA_HTTP_HOST=
CHROMA_HTTP_PORT=8001

# Checkpoint 持久化路径（留空则用默认 data/checkpoints/castflow.db）
CHECKPOINT_DB_PATH=data/checkpoints/castflow.db

# MCP 工具加载（true = agent 内部也通过 MCP 协议加载工具）
MCP_ENABLED=false

# 轮询调度器（真实值到达自动触发预测）
# 启用后，后台线程定时检查 DB 是否有新真实值，有则自动触发 forecast run
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SEC=300
# 监控月份列表（逗号分隔，留空则默认当前年份 1-12 月）
SCHEDULER_TARGET_MONTHS=
